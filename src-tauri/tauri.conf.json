{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Professor Soly Auto Clicker",
  "version": "1.0.0",
  "identifier": "com.professorsoly.autoclicker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Professor Soly Auto Clicker",
        "width": 860,
        "height": 690,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
